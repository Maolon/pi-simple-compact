{
  "name": "@maolon/pi-simple-compact",
  "version": "0.2.0",
  "description": "Choose the model, prompt and pipeline Pi uses to compact a session, without touching anything else. Inert until configured.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "pi-coding-agent",
    "compaction",
    "context",
    "summarization",
    "agents"
  ],
  "homepage": "https://github.com/Maolon/pi-simple-compact#readme",
  "bugs": {
    "url": "https://github.com/Maolon/pi-simple-compact/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Maolon/pi-simple-compact.git"
  },
  "license": "MIT",
  "author": "Maolon",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pipeline": "node --experimental-strip-types --test tests/*.cases.mjs",
    "test:contract": "node --experimental-strip-types --test tests/*.contract.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "test:e2e": "node scripts/e2e-tmux.mjs",
    "check": "npm run typecheck && npm test && npm run test:pipeline && npm run test:contract",
    "prepublishOnly": "npm run check && npm run build && npm run test:package"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
